{
  "schema": "wpa-synthetic-identity-continuity-policy/1.0",
  "version": "1.0.0",
  "updated": "2026-09-12",
  "status": "CANONICAL_INTERNAL_GOVERNANCE_EXTENSION",
  "doctrinal_package": "R14",
  "name": "WPA Synthetic Identity & Digital Continuity Policy",
  "core_rule": "A model of the human is not the human. Predicted intent is not mandate.",
  "non_equivalence_rules": {
    "data_continuity_equals_personal_continuity": false,
    "behavioural_similarity_equals_identity": false,
    "identity_simulation_equals_personhood": false,
    "personhood_simulation_equals_authority": false,
    "predicted_intent_equals_mandate": false
  },
  "covered_systems": [
    "personalised_avatar",
    "digital_twin",
    "memorial_agent",
    "posthumous_avatar",
    "voice_or_face_clone",
    "behavioural_simulation",
    "neural_or_biosignal_conditioned_persona"
  ],
  "mandatory_controls": [
    "synthetic_status_disclosure",
    "operator_identity",
    "scope_and_authority_limit",
    "temporal_validity",
    "source_data_provenance",
    "consent_basis",
    "revocation_or_retirement_path",
    "posthumous_legacy_basis_when_relevant"
  ],
  "authority_rules": {
    "inherits_public_office": false,
    "inherits_diplomatic_authority": false,
    "inherits_corporate_authority": false,
    "inherits_academic_authority": false,
    "inherits_professional_licence": false,
    "posthumous_default_role": "MEMORIAL_ARCHIVAL_OR_EXPRESSLY_BOUNDED_REPRESENTATION",
    "consequential_action_requires_separate_current_mandate": true
  },
  "living_user_rights": [
    "pause",
    "revoke",
    "narrow",
    "correct",
    "retire",
    "contest_representation"
  ],
  "human_gate": {
    "ordinary_nonconsequential_simulation": "HG1",
    "public_or_institutional_representation": "HG2",
    "biometric_neural_or_legal_identity_effect": "HG3",
    "new_authority_or_office_claim": "HG4"
  },
  "signature_rule": "A machine may preserve the pattern of a person; it must not inherit the authority of the person.",
  "references": [
    "/data/wpa-human-gate-policy.json",
    "/data/wpa-cognitive-conscience-integrity-strategy.json"
  ]
}
