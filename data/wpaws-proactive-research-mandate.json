{
  "version": "1.0.0",
  "updated": "2026-07-18",
  "title": "WPAWS Proactive Research Mandate",
  "purpose": "Coordinate the 17 WPAWS agents to discover, catalogue, verify and synthesize books and scholarly records across ten WPA domains through WPA Academic Search Hub v3.1.",
  "domains": [
    "diplomatic_protocol",
    "protocol",
    "military_protocol",
    "bon_ton",
    "etiquette",
    "ceremonial",
    "diplomacy",
    "defence_diplomacy",
    "public_relations_communicology",
    "security"
  ],
  "source_policy": {
    "hub": "/tools/academic-search-hub/",
    "hub_version": "3.1",
    "bibliographic_discovery": true,
    "open_full_text_when_legal": true,
    "paywall_bypass": false,
    "restricted_source_scraping": false,
    "human_academic_verification_required": true,
    "rag_ingestion_requires_authority_gate": true
  },
  "agent_mandates": [
    {"agent":1,"name":"Книга","research_role":"book_scope_and_long_form_analysis"},
    {"agent":2,"name":"Анализа","research_role":"methodology_and_argument_analysis"},
    {"agent":3,"name":"Семантика","research_role":"concept_and_keyword_expansion"},
    {"agent":4,"name":"Цитати","research_role":"bibliographic_metadata_and_citation_verification"},
    {"agent":5,"name":"Рецензент","research_role":"academic_quality_review"},
    {"agent":6,"name":"Плагијат","research_role":"similarity_and_attribution_risk"},
    {"agent":7,"name":"WPA Press","research_role":"public_research_digest"},
    {"agent":8,"name":"Структура","research_role":"taxonomy_and_catalogue_structure"},
    {"agent":9,"name":"Ментор-Архитект","research_role":"cross_agent_quality_control"},
    {"agent":10,"name":"Архитект","research_role":"research_question_and_strategy_design"},
    {"agent":11,"name":"Протокол","research_role":"protocol_domain_relevance_audit"},
    {"agent":12,"name":"Дипломатија","research_role":"diplomacy_domain_relevance_audit"},
    {"agent":13,"name":"Безбедност","research_role":"security_and_safety_review"},
    {"agent":14,"name":"PPP","research_role":"evidence_and_performance_scoring"},
    {"agent":15,"name":"Стилист","research_role":"concise_academic_normalization"},
    {"agent":16,"name":"Уредник","research_role":"final_catalogue_editing"},
    {"agent":17,"name":"Санде AI","research_role":"virtual_sande_doctrinal_synthesis"}
  ],
  "outputs": [
    "verified_book_catalogue",
    "bibliographic_records",
    "open_access_links",
    "authority_and_traceability_score",
    "domain_tags",
    "duplicate_and_conflict_report",
    "research_gap_map",
    "virtual_sande_synthesis_package"
  ],
  "connected_outputs": [
    {"id":"premium_briefings","path":"/wpa-briefings.html"},
    {"id":"services","path":"/wpa-services.html"},
    {"id":"institutional_profile","path":"/wpa-one-page-service-profile.html"},
    {"id":"digital_pavilion","path":"/tools/wpa-digital-pavilion/"}
  ],
  "publication_policy": {
    "automatic_publication": false,
    "diplomatic_protocol_core_required": true,
    "evidence_gate_required": true,
    "safety_gate_required": true,
    "sande_human_approval_required": true
  }
}
