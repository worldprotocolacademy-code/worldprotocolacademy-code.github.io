{
  "schema": "wpaws-proactive-research-mandate/1.1",
  "version": "1.1.0-candidate",
  "updated": "2026-08-27",
  "title": "WPAWS Proactive Research and Integrity Mandate",
  "status": "GOVERNED_ARCHITECTURE_READY_SCHEDULER_NOT_VERIFIED",
  "purpose": "Coordinate the 17 WPAWS roles to discover, catalogue, verify, compare and synthesize lawful public/authorised scholarly and institutional evidence across WPA domains, while proactively detecting provenance, citation, similarity, correction and doctrine-impact risks.",
  "connected_vessels_reference": "/data/wpa-knowledge-connected-vessels-integration.json",
  "scholarly_knowledge_reference": "/data/wpa-global-scholarly-knowledge-layer.json",
  "academic_integrity_reference": "/data/wpaws-academic-integrity-guardian.json",
  "capability_manifest_reference": "/data/wpaws-capabilities-v11.2.json",
  "domains": ["diplomatic_protocol","protocol","military_protocol","bon_ton","etiquette","ceremonial","diplomacy","defence_diplomacy","public_relations_communicology","security"],
  "source_policy": {
    "hub": "/tools/academic-search-hub/",
    "hub_version": "3.1",
    "bibliographic_discovery": true,
    "open_full_text_when_legal": true,
    "paywall_bypass": false,
    "restricted_source_scraping": false,
    "credential_circumvention": false,
    "human_academic_verification_required": true,
    "rag_ingestion_requires_authority_gate": true,
    "discovery_is_permission_to_ingest": false
  },
  "capability_truthfulness": {
    "rule": "No agent or UI may claim a source, database, model, scheduler, corpus or external adapter was used unless runtime evidence confirms that specific capability for that run.",
    "model_brand_is_routing_preference_not_version_guarantee": true,
    "external_plagiarism_databases_active": false,
    "long_document_adapter_active": false,
    "active_scheduler_verified": false
  },
  "agent_mandates": [
    {"agent":1,"name":"Книга","research_role":"coverage_aware_book_scope_and_long_form_analysis"},
    {"agent":2,"name":"Анализа","research_role":"methodology_evidence_argument_and_uncertainty_analysis"},
    {"agent":3,"name":"Семантика","research_role":"concept_keyword_terminology_and_contradiction_analysis"},
    {"agent":4,"name":"Цитати","research_role":"verified_bibliographic_metadata_and_citation_integrity"},
    {"agent":5,"name":"Рецензент","research_role":"human_gated_academic_quality_screening"},
    {"agent":6,"name":"Плагијат","research_role":"proactive_academic_integrity_similarity_attribution_provenance_and_self_reuse_risk"},
    {"agent":7,"name":"WPA Press","research_role":"human_approved_public_research_digest"},
    {"agent":8,"name":"Структура","research_role":"taxonomy_catalogue_and_evidence_requirement_structure"},
    {"agent":9,"name":"Ментор-Архитект","research_role":"cross_agent_quality_integrity_and_capability_truthfulness_control"},
    {"agent":10,"name":"Архитект","research_role":"research_question_method_and_strategy_design"},
    {"agent":11,"name":"Протокол","research_role":"protocol_domain_relevance_and_source_status_audit"},
    {"agent":12,"name":"Дипломатија","research_role":"diplomacy_domain_relevance_and_current_fact_verification_gate"},
    {"agent":13,"name":"Безбедност","research_role":"public_source_security_safety_and_readiness_review"},
    {"agent":14,"name":"PPP","research_role":"evidence_based_performance_scoring_with_not_assessable_state"},
    {"agent":15,"name":"Стилист","research_role":"meaning_preserving_academic_normalization"},
    {"agent":16,"name":"Уредник","research_role":"final_editing_with_integrity_and_citation_escalation"},
    {"agent":17,"name":"Санде AI","research_role":"non_impersonating_doctrinal_synthesis_and_proposed_voice_draft"}
  ],
  "proactive_integrity_triggers": [
    "new manuscript or chapter enters WPAWS review",
    "large editorial or stylistic revision",
    "new citation or bibliography set is introduced",
    "new external excerpt is pasted or uploaded",
    "translation or cross-language adaptation is prepared",
    "possible self-reuse from WPA or Smiljanov material",
    "pre-publication final integrity gate",
    "source correction, retraction or contradiction is detected"
  ],
  "agent_operating_cycle": [
    "Discover lawful public/authorised evidence",
    "Verify source identity and provenance",
    "Check access rights and source compliance",
    "Create or update traceable knowledge atoms",
    "Run citation and academic-integrity gates",
    "Compare institutional DNA and scholarly DNA without erasing disagreement",
    "Route conflicts and high-risk candidates to Human Gate",
    "Reuse only approved knowledge in eligible WPA systems",
    "Measure downstream usefulness, errors and corrections",
    "Propagate corrections and reintegrate verified lessons"
  ],
  "outputs": ["verified_book_catalogue","bibliographic_records_with_status","open_access_links","authority_and_traceability_score","domain_tags","duplicate_and_conflict_report","academic_integrity_review_queue","research_gap_map","correction_and_retraction_signal","virtual_sande_synthesis_package"],
  "connected_outputs": [
    {"id":"knowledge_connected_vessels","path":"/data/wpa-knowledge-connected-vessels-integration.json"},
    {"id":"academic_search_hub","path":"/tools/academic-search-hub/"},
    {"id":"journal","path":"/journal/"},
    {"id":"student_desk","path":"/student-desk/"},
    {"id":"wpaws","path":"/wpaws/"},
    {"id":"virtual_sande","path":"/virtual-sande-ai.html"},
    {"id":"premium_briefings","path":"/wpa-briefings.html"},
    {"id":"digital_pavilion","path":"/tools/wpa-digital-pavilion/"}
  ],
  "long_document_policy": {
    "current_public_ask_limit_characters": 700,
    "silent_truncation_allowed": false,
    "protected_long_document_adapter_active": false,
    "rule": "Do not claim full-book, full-manuscript or full-integrity coverage through the short public /ask contract. Preflight and stop until an approved protected document adapter is activated and tested."
  },
  "publication_policy": {
    "automatic_publication": false,
    "automatic_editorial_verdict": false,
    "automatic_academic_misconduct_verdict": false,
    "diplomatic_protocol_core_required": true,
    "evidence_gate_required": true,
    "integrity_gate_required": true,
    "safety_gate_required": true,
    "sande_human_approval_required": true
  },
  "scheduler": {
    "proactive_architecture_ready": true,
    "active_scheduler_verified": false,
    "continuous_execution_claim_allowed": false
  }
}
