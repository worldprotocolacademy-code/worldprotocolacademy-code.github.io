{
  "schema": "wpa-embodied-public-space-safety-policy/1.0",
  "version": "1.0.0",
  "updated": "2026-09-12",
  "status": "CANONICAL_INTERNAL_GOVERNANCE_EXTENSION",
  "doctrinal_package": "R15",
  "name": "WPA Embodied Public-Space Safety, De-escalation & Social Licence Policy",
  "core_rule": "Physical presence is not public authority. Provocation is not permission for machine retaliation.",
  "default_contact_response": "DE_ESCALATE_REDUCE_KINETIC_ENERGY_AND_REQUEST_HUMAN_ASSISTANCE",
  "covered_contexts": [
    "retail",
    "parks",
    "streets",
    "transport_hubs",
    "schools",
    "hospitals",
    "public_information_points",
    "traffic_assistance",
    "patrol_or_security_adjacent_roles"
  ],
  "mandatory_controls": [
    "role_legibility",
    "operator_identity",
    "capability_disclosure",
    "recording_status_disclosure",
    "minimum_distance_and_speed_envelope",
    "force_limit",
    "non_retaliation_logic",
    "human_override",
    "safe_state",
    "complaint_or_remedy_route",
    "incident_telemetry"
  ],
  "hard_prohibitions": [
    "retaliatory_force_for_insult_or_non_dangerous_contact",
    "pursuit_for_punishment",
    "coercive_body_positioning_without_lawful_safety_basis",
    "authority_claim_from_humanoid_appearance_or_uniform",
    "shutdown_design_requiring_physical_wrestling"
  ],
  "authority_signalling_rules": {
    "uniform_creates_public_authority": false,
    "humanlike_appearance_creates_public_authority": false,
    "traffic_gesture_creates_legal_authority": false,
    "patrol_presence_creates_enforcement_power": false,
    "lawful_institutional_mandate_required": true
  },
  "social_licence_controls": [
    "public_purpose",
    "proportionality",
    "vulnerable_group_testing",
    "human_alternative_for_material_rights_or_services",
    "accessible_complaint_path"
  ],
  "incident_record": [
    "timestamp",
    "control_mode",
    "model_and_deployment_identity",
    "sensor_state",
    "motion_state",
    "human_proximity",
    "operator_intervention",
    "override_or_shutdown_event",
    "recovery_status"
  ],
  "human_gate": {
    "ordinary_service_role": "HG1",
    "public_consequence_or_recording": "HG2",
    "security_policing_health_or_identity_sensitive_role": "HG3",
    "new_public_authority_claim": "HG4"
  },
  "signature_rules": [
    "Physical presence is not public authority.",
    "Visibility is not legitimacy.",
    "Provocation is not permission for machine retaliation."
  ],
  "references": [
    "/data/wpa-human-gate-policy.json",
    "/data/wpa-human-governed-agentic-institution-model.json"
  ]
}
