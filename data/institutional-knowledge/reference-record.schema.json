{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy.mk/data/institutional-knowledge/reference-record.schema.json",
  "title": "WPA Reference Record",
  "type": "object",
  "required": [
    "reference_id",
    "source_id",
    "source_type",
    "title",
    "original_url",
    "retrieved_at",
    "access_basis",
    "locator",
    "citation_status",
    "metadata_evidence"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "institution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": "string"
    },
    "author_or_corporate_author": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher_or_institution": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_date_or_year": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition_or_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ]
    },
    "issn": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_url": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "access_basis": {
      "type": "string"
    },
    "licence_or_rights_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "locator": {
      "type": "object"
    },
    "citation_status": {
      "type": "string"
    },
    "metadata_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_status": {
      "type": "string"
    },
    "correction_status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
