{
  "schema": "wpa-human-gate-policy/1.0",
  "version": "1.0.0",
  "updated": "2026-08-25",
  "name": "WPA Human Gate Policy",
  "name_mk": "Политика на Човечката порта на WPA",
  "status": "CANONICAL_INTERNAL_GOVERNANCE_POLICY",
  "external_standard": false,
  "core_rule": "Automation may prepare, route, compare, model and execute reversible bounded tasks. It may not create its own institutional authority or release consequential institutional action without the required human authorisation.",
  "core_rule_mk": "Автоматизацијата може да подготвува, насочува, споредува, моделира и извршува ограничени обратливи задачи. Таа не може сама да создава институционално овластување ниту да ослободи последично значајно институционално дејство без потребното човечко овластување.",
  "default_mode": "FAIL_CLOSED_WHEN_AUTHORITY_OR_CONSEQUENCE_IS_UNCLEAR",
  "decision_classes": [
    {
      "class": "HG0",
      "name": "Informational and reversible",
      "examples": ["navigation", "public-source discovery", "formatting", "draft classification", "non-consequential summarisation"],
      "automation": "ALLOWED_WITHIN_APPROVED_SCOPE",
      "human_preapproval": false,
      "audit": "proportionate"
    },
    {
      "class": "HG1",
      "name": "Bounded operational",
      "examples": ["routing", "draft generation", "comparison", "research queue preparation", "reversible workflow assistance"],
      "automation": "ALLOWED_UNDER_PREAPPROVED_MANDATE",
      "human_preapproval": false,
      "human_escalation": "required_on_exception_uncertainty_or_scope_change",
      "audit": "required_for_material_handoffs"
    },
    {
      "class": "HG2",
      "name": "Consequential institutional",
      "examples": ["official publication release", "institutional statement", "external deliverable", "material correction", "public benchmark conclusion"],
      "automation": "PREPARE_ONLY_UNTIL_APPROVED",
      "human_preapproval": true,
      "release_without_human_gate": false,
      "audit": "mandatory"
    },
    {
      "class": "HG3",
      "name": "Legally financially academically or credential sensitive",
      "examples": ["identity verification", "enrolment", "payment status decision", "official assessment record", "certificate authorisation", "certificate issue or revocation", "privacy-sensitive record change"],
      "automation": "ASSIST_ONLY_UNLESS_PRIVATE_BACKEND_AND_SPECIFIC_AUTHORISATION_EXIST",
      "human_preapproval": true,
      "private_backend_required": true,
      "role_based_access_required": true,
      "immutable_audit_required": true
    },
    {
      "class": "HG4",
      "name": "Constitutional doctrine and mandate",
      "examples": ["Doctrine Kernel change", "new institutional authority", "Human Gate weakening", "provider partnership claim", "accreditation claim", "official external commitment"],
      "automation": "PROHIBITED_AS_FINAL_DECISION_MAKER",
      "human_preapproval": true,
      "authorised_human_authority_required": true,
      "automatic_override": false,
      "immutable_audit_required": true
    }
  ],
  "mandatory_handoff_record": [
    "source_or_provenance",
    "current_mandate",
    "permitted_scope",
    "transformation_performed",
    "material_uncertainty",
    "responsible_human_owner",
    "pause_or_override_path",
    "release_condition"
  ],
  "pause_conditions": [
    "unclear mandate",
    "unclear source rights",
    "identity or consent uncertainty",
    "material factual conflict",
    "privacy or security concern",
    "scope expansion",
    "irreversible or difficult-to-reverse consequence",
    "new external commitment",
    "credential or payment consequence"
  ],
  "override_policy": {
    "machine_override_of_human_gate": false,
    "human_override_requires_reason": true,
    "human_override_requires_actor": true,
    "human_override_requires_timestamp": true,
    "human_override_requires_previous_and_new_state": true,
    "doctrine_change_requires_separate_authority": true
  },
  "references": [
    "/data/wpa-doctrine-kernel.json",
    "/data/wpa-preventive-source-compliance-gate.json",
    "/data/wpa-academic-quality-standard.json",
    "/data/wpa-continuous-institutional-learning-loop.json",
    "/data/wpa-student-operations-backend-schema.json"
  ],
  "non_claims": [
    "This policy does not mean every WPA workflow is fully automated today.",
    "This policy does not activate enrolment, payments, official assessment records or certificates.",
    "This policy does not create government, legal, financial or accreditation authority.",
    "This policy does not permit surveillance, intelligence or autonomous operational authority."
  ]
}
