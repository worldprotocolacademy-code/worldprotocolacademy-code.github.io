{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy-code.github.io/data/global-institutions/pilot-20/v1.3.2/pilot20-package.schema.json",
  "title": "WPA Pilot 20 Extraction Manifest",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "source", "guardrails", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool": {"const": "WPA Pilot 20 secure extractor"},
    "tool_version": {"const": "1.3.2"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["extract", "verify", "dry-run", "list"]},
    "source": {
      "type": "object",
      "required": ["relative_path", "git_blob_sha1", "archive_sha256"],
      "properties": {
        "relative_path": {"type": "string"},
        "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "required": ["rev2_changed", "d002_applied", "d002_status", "h005_next_action"],
      "properties": {
        "rev2_changed": {"const": false},
        "d002_applied": {"const": false},
        "d002_status": {"const": "APPROVED_FOR_NEXT_CANONICAL_REVISION_NOT_APPLIED"},
        "h005_next_action": {"const": "MANUAL_REVIEW_AND_REATTEMPT_IN_NEXT_BATCH_CYCLE"}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 5242880},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
