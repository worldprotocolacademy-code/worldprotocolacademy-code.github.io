{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy.mk/data/institute-index/g15-review-decision-record.schema.json",
  "title": "Protocolometry G15 Independent Methodological Review Decision Record",
  "type": "object",
  "required": [
    "record_version",
    "review_id",
    "review_route",
    "reviewer",
    "eligibility",
    "review_target",
    "scope",
    "findings",
    "reviewer_conclusion",
    "wpa_response",
    "follow_up",
    "public_claim_boundary"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "review_route": {
      "enum": [
        "AAB",
        "AUTHORISED_EXTERNAL_EQUIVALENT"
      ]
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "written_acceptance",
        "coi_declaration_completed",
        "scope_accepted"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "written_acceptance": {
          "const": true
        },
        "coi_declaration_completed": {
          "const": true
        },
        "scope_accepted": {
          "const": true
        },
        "public_listing_consent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "public_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "eligibility": {
      "type": "object",
      "required": [
        "authorised",
        "material_conflict",
        "recusal_required",
        "eligible_for_assignment"
      ],
      "properties": {
        "authorised": {
          "const": true
        },
        "material_conflict": {
          "const": false
        },
        "recusal_required": {
          "const": false
        },
        "eligible_for_assignment": {
          "const": true
        },
        "aab_formally_constituted": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "review_target": {
      "type": "object",
      "required": [
        "freeze_candidate_id",
        "methodology_version",
        "manifest_path"
      ],
      "properties": {
        "freeze_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "methodology_version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "const": "/data/institute-index/protocolometry-v1-freeze-candidate-manifest.json"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "domain_id",
          "severity",
          "finding",
          "evidence_reference",
          "reviewer_recommendation"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "pattern": "^R(0[1-9]|1[01])$"
          },
          "severity": {
            "enum": [
              "OBSERVATION",
              "MINOR",
              "MAJOR",
              "CRITICAL"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_recommendation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "reviewer_conclusion": {
      "enum": [
        "NO_MATERIAL_OBJECTION",
        "REVISION_REQUIRED",
        "MAJOR_REVISION_REQUIRED",
        "NOT_READY_FOR_FREEZE"
      ]
    },
    "wpa_response": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "disposition",
          "reasoning",
          "change_reference"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "ACCEPT",
              "PARTIAL_ACCEPT",
              "DECLINE",
              "DEFER"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "change_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up": {
      "type": "object",
      "required": [
        "required",
        "completed"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "record_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "public_claim_boundary": {
      "const": "INDEPENDENT_METHODOLOGICAL_REVIEW_NOT_PEER_REVIEW_ACCREDITATION_RECOGNITION_OR_ENDORSEMENT"
    },
    "final_freeze_authority": {
      "const": false
    }
  },
  "additionalProperties": true
}
