{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy.mk/data/institute-index/scoring-record.schema.json",
  "title": "WPA Institute Index Candidate Scoring Record",
  "description": "Candidate schema for controlled Pilot 20 dry-run scoring under WPA Institute Index Methodology v0.9.1. It does not create a public ranking.",
  "type": "object",
  "required": ["methodology_version", "institution_id", "institution_name", "group", "assessment_status", "indicators", "human_review"],
  "properties": {
    "methodology_version": {"const": "0.9.1-candidate"},
    "dataset_snapshot": {"type": "string", "format": "date"},
    "institution_id": {"type": "string", "minLength": 1},
    "institution_name": {"type": "string", "minLength": 1},
    "group": {"type": "string", "enum": ["A","B","C","D","G","H","I","R"]},
    "peer_type": {"type": ["string","null"], "enum": ["STATE_FOREIGN_SERVICE","INDEPENDENT_PROTOCOL","UNIVERSITY_LINKED","INTERNATIONAL_TRAINING",null]},
    "assessment_status": {"type": "string", "enum": ["DRAFT","FIRST_PASS_COMPLETE","SECOND_PASS_COMPLETE","RECONCILIATION_PENDING","HUMAN_REVIEW_COMPLETE","CORRECTION_WINDOW","DISPUTED","PILOT_LOCKED"]},
    "assessor_pass": {"type": "string", "enum": ["PASS_1","PASS_2","RECONCILED"]},
    "indicators": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["indicator_id","dimension_id","indicator_weight_percent","score","evidence"],
        "properties": {
          "indicator_id": {"type": "string", "pattern": "^I(0[1-9]|1[0-9]|20)$"},
          "dimension_id": {"type": "string", "enum": ["D1","D2","D3","D4"]},
          "indicator_weight_percent": {"type": "number", "enum": [4,5,6]},
          "score": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 5},{"const": "NE"}]},
          "assessor_note": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_tier","locator","retrieved_at","supports_claim"],
              "properties": {
                "source_tier": {"type": "string", "enum": ["A","B","C","D"]},
                "locator": {"type": "string", "minLength": 1},
                "title": {"type": "string"},
                "retrieved_at": {"type": "string", "format": "date"},
                "supports_claim": {"type": "string", "minLength": 1},
                "archive_or_identifier": {"type": ["string","null"]}
              },
              "additionalProperties": false
            }
          },
          "dispute_status": {"type": "string", "enum": ["NONE","CORRECTION_REQUESTED","DISPUTED","RESOLVED"]}
        },
        "additionalProperties": false
      }
    },
    "computed": {
      "type": "object",
      "properties": {
        "weighted_evidence_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "dimension_scores": {
          "type": "object",
          "properties": {
            "D1": {"type": ["number","null"], "minimum": 0, "maximum": 100},
            "D2": {"type": ["number","null"], "minimum": 0, "maximum": 100},
            "D3": {"type": ["number","null"], "minimum": 0, "maximum": 100},
            "D4": {"type": ["number","null"], "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "candidate_composite": {"type": ["number","null"], "minimum": 0, "maximum": 100},
        "composite_status": {"type": "string", "enum": ["AVAILABLE","INSUFFICIENT_EVIDENCE_FOR_COMPOSITE"]},
        "peer_percentile": {"type": ["number","null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": ["required","completed"],
      "properties": {
        "required": {"const": true},
        "completed": {"type": "boolean"},
        "reviewer": {"type": ["string","null"]},
        "reviewed_at": {"type": ["string","null"], "format": "date"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "correction_window": {
      "type": "object",
      "properties": {
        "offered": {"type": "boolean"},
        "opened_at": {"type": ["string","null"], "format": "date"},
        "closed_at": {"type": ["string","null"], "format": "date"},
        "institution_response_locator": {"type": ["string","null"]}
      },
      "additionalProperties": false
    },
    "public_ordinal_rank": {"const": null}
  },
  "additionalProperties": false
}
