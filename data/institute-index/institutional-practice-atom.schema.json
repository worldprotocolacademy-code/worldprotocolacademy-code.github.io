{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy.mk/data/institute-index/institutional-practice-atom.schema.json",
  "title": "WPA Institutional Practice Atom",
  "description": "A source-traceable, reusable unit of institutional practice derived from a human-reviewable Evidence Dossier. Practice Atoms are evidence objects, not rankings, endorsements or instructions to copy another institution.",
  "type": "object",
  "required": [
    "atom_id",
    "institution_id",
    "institution_name",
    "practice_title",
    "practice_summary",
    "source_refs",
    "evidence_status",
    "reuse_status",
    "human_review_status"
  ],
  "properties": {
    "atom_id": {"type": "string", "pattern": "^IPA-[A-Z0-9-]+$"},
    "institution_id": {"type": "string"},
    "institution_name": {"type": "string"},
    "country": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "peer_type": {"type": ["string", "null"]},
    "practice_title": {"type": "string"},
    "practice_summary": {"type": "string"},
    "practice_type": {
      "type": "array",
      "items": {"type": "string"},
      "examples": ["programme_architecture", "simulation", "assessment", "research", "practitioner_integration", "cooperation", "governance", "correction", "credential_integrity"]
    },
    "i01_i20_links": {
      "type": "array",
      "items": {"type": "string", "pattern": "^I(0[1-9]|1[0-9]|20)$"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url_or_identifier", "source_tier", "retrieved"],
        "properties": {
          "url_or_identifier": {"type": "string"},
          "source_tier": {"enum": ["A", "B", "C", "D"]},
          "retrieved": {"type": "string"},
          "supports": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_status": {
      "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "CONTRADICTED", "STALE_OR_UNCLEAR", "NE"]
    },
    "confidence": {
      "enum": ["HIGH", "MODERATE", "LOW", "NOT_ASSIGNED"]
    },
    "distinctive_value": {
      "enum": ["COMMON_PATTERN", "NOTABLE_PATTERN", "DISTINCTIVE_PATTERN", "METHODOLOGY_REVIEW_TRIGGER", "NOT_ASSESSED"]
    },
    "reuse_status": {
      "enum": ["HOLD", "ELIGIBLE_AFTER_HUMAN_REVIEW", "APPROVED_FOR_GOVERNED_REUSE", "WITHHELD"]
    },
    "approved_reuse_domains": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reuse_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_review_status": {
      "enum": ["PENDING", "APPROVED", "REVISED", "WITHHELD"]
    },
    "review_note": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "updated": {"type": ["string", "null"]}
  },
  "reuse_invariant": "A Practice Atom may be reused only with its provenance and context intact. Reuse means learning, comparison, synthesis or adaptation; it does not mean copying proprietary content or presenting another institution's practice as WPA authorship.",
  "authority_invariant": "Agents may propose atoms and reuse routes. Approval for consequential WPA institutional use remains human-governed."
}
