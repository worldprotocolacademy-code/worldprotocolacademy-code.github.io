{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldprotocolacademy.mk/data/institute-index/g16-publication-decision-record.schema.json",
  "title": "Protocolometry G16 Publication Decision Record",
  "type": "object",
  "required": [
    "record_version",
    "decision_id",
    "decision_date",
    "authority",
    "prerequisites",
    "eligible_modes",
    "selected_mode",
    "reasoning",
    "public_claim_boundary",
    "automatic_escalation"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "object",
      "required": [
        "authority_id",
        "authorised_human_governance",
        "coi_checked"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "authorised_human_governance": {
          "const": true
        },
        "coi_checked": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "prerequisites": {
      "type": "object",
      "required": [
        "g01_to_g15_complete",
        "g14_v1_frozen",
        "g15_review_complete",
        "release_package_integrity_verified"
      ],
      "properties": {
        "g01_to_g15_complete": {
          "type": "boolean"
        },
        "g14_v1_frozen": {
          "type": "boolean"
        },
        "g15_review_complete": {
          "type": "boolean"
        },
        "release_package_integrity_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "eligible_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "R0",
          "R1",
          "R2",
          "R3"
        ]
      },
      "uniqueItems": true
    },
    "selected_mode": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "conditions_or_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_claim_boundary": {
      "const": "MEASUREMENT_NOT_ACCREDITATION_RECOGNITION_ENDORSEMENT_OR_AUTOMATIC_RANKING_AUTHORITY"
    },
    "automatic_escalation": {
      "const": false
    },
    "supersedes_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "signed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature_or_written_approval_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_mode": {
            "const": "R3"
          }
        }
      },
      "then": {
        "properties": {
          "prerequisites": {
            "properties": {
              "g01_to_g15_complete": {
                "const": true
              },
              "g14_v1_frozen": {
                "const": true
              },
              "g15_review_complete": {
                "const": true
              },
              "release_package_integrity_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
