  "title": "WPA Institute Index / Protocolometry — Four-Pillar Operating Model",
  "principle": "The global corpus tests the methodology; the methodology must not erase the diversity of the corpus.",
  "pillars": [
    {
      "id": "P1",
      "name": "Global Coverage Expansion",
      "objective": "Build the most defensible global corpus of diplomatic academies, foreign-service institutes, protocol schools and closely related institutions without treating 160 as a ceiling.",
      "inputs": ["REV3 frozen baseline", "IFDT discovery directory", "national MFA sites", "official institutional sites", "authoritative corroborating sources"],
      "outputs": ["REV4 candidate intake", "country/region coverage register", "entity-resolution queue", "successor/alias/branch decisions"],
      "controls": ["no automatic canonical merge", "primary source preferred", "duplicate/successor review", "Human Gate"]
    },
    {
      "id": "P2",
      "name": "Institutional Core Extraction Engine",
      "objective": "Extract the documented institutional DNA of each resolved institution from public, lawful and attributable evidence.",
      "inputs": ["official programme pages", "public curricula", "research/publication pages", "governance pages", "public reports and policies", "authoritative external records"],
      "outputs": ["Institution Evidence Dossier", "source register", "distinctive-practice register", "I01-I20 evidence map", "uncertainty/contradiction notes"],
      "controls": ["public evidence only", "no access-control bypass", "NE is not zero", "source tier A-D", "no autonomous consequential publication"]
    },
    {
      "id": "P3",
      "name": "Methodology Validation",
      "objective": "Use extracted practices to test whether I01-I20 are complete, non-duplicative, fair across peer types and stable under reasonable weighting choices.",
      "inputs": ["approved evidence dossiers", "20-indicator candidate methodology", "peer types", "correction records"],
      "outputs": ["practice-to-indicator coverage matrix", "double-scoring reliability report", "weight sensitivity report", "correlation/redundancy report", "peer-type fairness report", "missingness report"],
      "controls": ["no weight tuning for preferred winners", "high correlation is a review trigger", "edge-case testing", "evidence thresholds", "correction test"]
    },
    {
      "id": "P4",
      "name": "Human Governance and Publication Gate",
      "objective": "Keep institutional authority, dispute resolution and consequential publication under accountable human control.",
      "inputs": ["candidate dossiers", "QA findings", "corrections", "COI records", "validation reports"],
      "outputs": ["human-reviewed inclusion decisions", "accepted/revised/withheld scores", "correction outcomes", "v1.0 freeze decision", "separate public-ranking decision if ever authorised"],
      "controls": ["AAB review only after formal constitution", "COI declaration", "right of correction", "measurement is not accreditation", "public ordinal ranking disabled until separate decision"]
    }
  ],
