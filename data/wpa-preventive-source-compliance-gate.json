{"version":"1.1.1","updated":"2026-07-18","title":"WPA Preventive Source Compliance Gate","status":"governed_machine_readable_policy","purpose":"Prevent unauthorised access acquisition reading processing indexing citation retention distribution or RAG ingestion before any WPA agent touches protected content","mode":"fail_closed","trigger_position":"before_any_content_access","default_decision":"deny_until_verified","required_checks":["source_identity","provenance","access_method","licence_or_permission","intended_use","quotation_rights","retention_rights","rag_ingestion_rights"],"allowed_sources":["public_open_access","wpa_owned","lawfully_purchased","institutionally_licensed","explicitly_authorised","user_supplied_with_confirmed_rights"],"prohibited_actions":{"credential_or_authentication_bypass":true,"paywall_or_drm_bypass":true,"restricted_scraping":true,"silent_download":true,"use_of_leaked_stolen_or_obviously_unauthorised_copy":true,"unverified_rag_ingestion":true,"log_deletion_or_concealment":true},"unknown_or_unclear_rights":{"decision":"blocked","content_may_be_opened":false,"content_may_be_read":false,"content_may_be_indexed":false,"content_may_be_cited":false,"content_may_be_retained":false,"content_may_enter_rag":false},"incident_response":{"quarantine_without_content_processing":true,"record_source_url_and_metadata":true,"notify_sande":true,"verify_licence_or_permission":true,"delete_if_unauthorised_after_preserving_required_audit_record":true,"concealment_forbidden":true},"confidentiality":{"incident_record_is_internal_need_to_know":true,"confidentiality_does_not_authorise_concealment_of_unlawful_activity":true},"release_gate":{"source_compliance_must_pass":true,"human_review_required_for_unclear_rights":true,"automatic_override":false}}