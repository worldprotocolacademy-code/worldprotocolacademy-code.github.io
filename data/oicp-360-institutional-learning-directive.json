{
  "schema": "wpa-oicp-360-institutional-learning/1.0",
  "version": "1.0.0-draft",
  "updated": "2026-09-06",
  "status": "DRAFT_FOR_HUMAN_REVIEW",
  "source_institution": {
    "canonical_id": "A026",
    "name": "International Organization of Ceremonial and Protocol (OICP)",
    "official_website": "https://www.oicp-protocolo.com/",
    "established": "2001",
    "verification": "PRIMARY_SOURCE_PLUS_INDEPENDENT_INSTITUTIONAL_CORROBORATION"
  },
  "purpose": "Extract source-supported institutional lessons from OICP, compare them with WPA Institute architecture, and route only approved, provenance-preserving lessons into WPA strategy, research, governance, education, data and future institutional development.",
  "governing_principles": [
    "External institutional practice is evidence, not authority.",
    "Reuse means learning, comparison, synthesis or adaptation; it does not mean copying protected expression.",
    "Every candidate lesson must preserve source identity, context, uncertainty and retrieval date.",
    "Agents may discover, extract, classify and recommend; consequential institutional adoption remains human-governed.",
    "No external relationship, endorsement, accreditation, membership, authority or partnership may be inferred from public evidence.",
    "Absence from a public website is not proof that a practice, member, country or relationship does not exist.",
    "WPA should preserve its own distinctive Human Gate, provenance, Protocolometry and human-governed AI architecture."
  ],
  "human_gate": {
    "research_and_public_source_extraction": "HG0_HG1",
    "strategy_application": "HG2",
    "public_institutional_statement": "HG2",
    "curriculum_or_methodology_change": "HG2_OR_HIGHER",
    "credential_or_registry_activation": "HG3_HG4",
    "doctrine_change": "HG4",
    "formal_partnership_or_external_commitment": "HG4"
  },
  "agent_lanes": [
    {
      "id": "OICP-A1",
      "name": "Institutional Core Agent",
      "scope": ["history", "founding", "mission", "vision", "values", "objectives", "governance", "membership architecture"],
      "output": "source-traceable institutional core map"
    },
    {
      "id": "OICP-A2",
      "name": "AICP Knowledge Architecture Agent",
      "scope": ["academy statutes", "academic categories", "research functions", "intellectual activities", "knowledge preservation"],
      "output": "AICP-to-WPA research architecture comparison"
    },
    {
      "id": "OICP-A3",
      "name": "International Data Center Agent",
      "scope": ["country coverage", "country-page fields", "source visibility", "update model", "gaps", "North Macedonia visibility"],
      "output": "field map plus WPA Evidence-Grade Global Protocol Atlas requirements"
    },
    {
      "id": "OICP-A4",
      "name": "Deontology and Standards Agent",
      "scope": ["ethics", "deontology", "professional conduct", "good practice", "professionalisation", "registry/certification architecture"],
      "output": "ethics and authority risk map"
    },
    {
      "id": "OICP-A5",
      "name": "Congress and Network Intelligence Agent",
      "scope": ["congress chronology", "countries", "themes", "professional network", "associations", "institutional continuity"],
      "output": "event/network institutional-memory map"
    },
    {
      "id": "OICP-A6",
      "name": "Publications and Knowledge Agent",
      "scope": ["articles", "publications", "research themes", "professional knowledge continuity"],
      "output": "knowledge-production and continuity map"
    },
    {
      "id": "OICP-A7",
      "name": "Future Protocol Agent",
      "scope": ["innovation", "digitalisation", "technology", "institutional communication", "future protocol"],
      "output": "OICP frontier map versus WPA Digital Protocol and Human-Governed AI"
    },
    {
      "id": "OICP-A8",
      "name": "Evidence and Provenance Agent",
      "scope": ["source tier", "retrieval date", "rights boundary", "contradiction", "uncertainty", "independent corroboration"],
      "output": "evidence register and confidence classification"
    },
    {
      "id": "OICP-A9",
      "name": "WPA Transformation Agent",
      "scope": ["candidate Practice Atoms", "KEEP_ADAPT_SURPASS_DO_NOT_IMPORT classification", "reuse-domain routing", "impact hypothesis"],
      "output": "human-review queue only"
    }
  ],
  "pipeline": [
    "COLLECT",
    "RIGHTS_SOURCE_CHECK",
    "VERIFY",
    "EXTRACT",
    "CLASSIFY",
    "COMPARE",
    "WPA_NATIVE_TRANSFORM",
    "QA",
    "HUMAN_GATE",
    "APPLY_WITHIN_APPROVED_SCOPE",
    "MEASURE",
    "CORRECT",
    "KNOWLEDGE_REINTEGRATION"
  ],
  "lesson_classes": [
    "KEEP",
    "ADAPT",
    "SURPASS",
    "DO_NOT_IMPORT",
    "INSUFFICIENT_EVIDENCE"
  ],
  "priority_lessons": [
    {
