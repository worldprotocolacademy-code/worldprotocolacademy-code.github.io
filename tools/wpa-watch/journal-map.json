{
  "version": "0.2",
  "purpose": "Map WPA Watch domains to WPA Journal disciplines and article types with backward-compatible aliases.",
  "domain_aliases": {
    "protocol": "protokol",
    "protokol": "protokol",
    "diplomacy": "diplomatija",
    "diplomatija": "diplomatija",
    "pr": "pr",
