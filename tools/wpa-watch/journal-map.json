      "preferred_types": [
        "Research article",
        "Policy brief",
        "Case study"
      ]
    },
    "pr": {
      "discipline": "pr",
      "preferred_types": [
        "Practitioner article",
        "Policy brief",
        "Methodology note"
      ]
    },
    "bezbednost": {
      "discipline": "security",
      "preferred_types": [
        "Policy brief",
        "Case study",
        "Research article"
      ]
    },
    "komunikologija": {
      "discipline": "communicology",
      "preferred_types": [
        "Research article",
        "Teaching note",
        "Methodology note"
      ]
    },
    "akademski": {
      "discipline": "academic",
      "preferred_types": [
        "Methodology note",
        "Research infrastructure note",
        "Book review",
        "Teaching note"
      ]
    }
  },
  "rules": [
    "Detected events are not accepted articles.",
    "Every topic candidate requires editorial screening.",
    "Every research article requires peer review.",
    "Security-sensitive topics require additional human review.",
    "Noise or placeholder signals are held for classification review rather than deleted automatically.",
    "AI may assist drafting editorial notes but cannot be an author or reviewer."
