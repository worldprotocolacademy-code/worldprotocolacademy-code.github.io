    "communicology": "komunikologija",
    "komunikologija": "komunikologija",
    "academic": "akademski",
    "akademski": "akademski",
    "general": "komunikologija"
  },
  "domain_to_journal": {
    "protokol": {
      "discipline": "protocol",
