{
  "schema": "wpa-growth-flywheel/1.0",
  "version": "1.0.0",
  "updated": "2026-09-27",
  "purpose": "Human-governed audience-growth scoring. No guarantee of reach, followers or revenue.",
  "scope_lock": [
    "protocol",
    "diplomacy",
    "public_relations",
    "security",
    "communicology"
  ],
  "candidate_weights": {
    "scope_strength": 20,
    "evidence_readiness": 20,
    "timeliness": 12,
    "audience_relevance": 13,
    "visual_explainability": 10,
    "share_utility": 10,
    "series_fit": 5,
    "translation_portability": 5,
    "cta_clarity": 5
  },
  "candidate_penalties": {
    "outside_scope": -60,
    "unverified_sensitive_claim": -35,
    "single_weak_source": -20,
    "duplicate_topic": -18,
    "paywall_only_without_public_corroboration": -12,
    "political_persuasion_or_electoral_prediction": -60
  },
  "performance_weights": {
    "chose_to_view": 24,
    "average_percent_viewed": 26,
    "shares_per_1000_views": 14,
    "saves_per_1000_views": 10,
    "follows_per_1000_views": 16,
    "source_click_rate": 5,
    "qualified_inquiry_rate": 5
  },
  "rules": [
    "No purchased followers, bots, engagement pods, spam or platform-rule evasion.",
    "Human Gate overrides growth score.",
    "Use real platform analytics when connected; otherwise label metrics MANUAL.",
    "Winning formats may repeat, but facts and sources must be re-verified for each publication."
  ]
}